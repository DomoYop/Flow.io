{"ok":true,"module":"poollogic/heater","docs":{"poollogic/heater/heater_auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.heater.heater_auto_mode.label","help_t":"cfgdocs.poollogic.heater.heater_auto_mode.help","label":"Mode auto chauffage","label_i18n":"cfgdocs.poollogic.heater.heater_auto_mode.label","help":"Active la régulation automatique de la température d'eau via le chauffage.","help_i18n":"cfgdocs.poollogic.heater.heater_auto_mode.help"},"poollogic/heater/heater_setpoint":{"type":"Float","label_t":"cfgdocs.poollogic.heater.heater_setpoint.label","help_t":"cfgdocs.poollogic.heater.heater_setpoint.help","unit":"C","label":"Consigne chauffage (C)","label_i18n":"cfgdocs.poollogic.heater.heater_setpoint.label","help":"Température cible eau pour la régulation du chauffage.","help_i18n":"cfgdocs.poollogic.heater.heater_setpoint.help"},"poollogic/heater/heater_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.heater.heater_slot.label","help_t":"cfgdocs.poollogic.heater.heater_slot.help","enum_set":"poollogic_device_slot","label":"Appareil piloté","label_i18n":"cfgdocs.poollogic.heater.heater_slot.label","help":"Appareil PDM commandé par cette fonction. « Aucun » désactive la fonction.","help_i18n":"cfgdocs.poollogic.heater.heater_slot.help"}},"meta":{}}