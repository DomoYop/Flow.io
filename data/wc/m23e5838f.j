{"ok":true,"module":"poollogic/sensors","docs":{"poollogic/sensors/air_temp_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.air_temp_io_id.label","help_t":"cfgdocs.poollogic.sensors.air_temp_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO température air","label_i18n":"cfgdocs.poollogic.sensors.air_temp_io_id.label","help":"Identifiant IO de la sonde température air.","help_i18n":"cfgdocs.poollogic.sensors.air_temp_io_id.help"},"poollogic/sensors/cover_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.cover_io_id.label","help_t":"cfgdocs.poollogic.sensors.cover_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO capteur volet fermé","label_i18n":"cfgdocs.poollogic.sensors.cover_io_id.label","help":"Identifiant IO de l'entrée digitale contact volet fermé.","help_i18n":"cfgdocs.poollogic.sensors.cover_io_id.help"},"poollogic/sensors/dis_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.dis_io_id.label","help_t":"cfgdocs.poollogic.sensors.dis_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO capteur ORP","label_i18n":"cfgdocs.poollogic.sensors.dis_io_id.label","help":"Identifiant IO de la mesure ORP.","help_i18n":"cfgdocs.poollogic.sensors.dis_io_id.help","visible_if":{"path":"poollogic/bassin/disinfection_type","in":[1,2,3]}},"poollogic/sensors/dis_lvl_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.dis_lvl_io_id.label","help_t":"cfgdocs.poollogic.sensors.dis_lvl_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO niveau bidon désinfectant","label_i18n":"cfgdocs.poollogic.sensors.dis_lvl_io_id.label","help":"Identifiant IO de l'entrée digitale « niveau bas » du bidon de désinfectant.","help_i18n":"cfgdocs.poollogic.sensors.dis_lvl_io_id.help","visible_if":{"path":"poollogic/bassin/disinfection_type","in":[1,3]}},"poollogic/sensors/flow_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.flow_io_id.label","help_t":"cfgdocs.poollogic.sensors.flow_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO capteur débit (flowswitch)","label_i18n":"cfgdocs.poollogic.sensors.flow_io_id.label","help":"Identifiant IO de l'entrée digitale flowswitch (détection de débit).","help_i18n":"cfgdocs.poollogic.sensors.flow_io_id.help"},"poollogic/sensors/flow_present":{"type":"Bool","label_t":"cfgdocs.poollogic.sensors.flow_present.label","help_t":"cfgdocs.poollogic.sensors.flow_present.help","label":"Flowswitch installé","label_i18n":"cfgdocs.poollogic.sensors.flow_present.label","help":"À activer une fois le capteur de débit réellement câblé. Il devient alors la référence pour savoir si l'eau circule, à la place de l'état de la pompe : les mesures restent donc valides même quand la filtration est forcée à la main, hors du firmware. Tant que ce réglage est inactif, l'entrée est ignorée — laissée libre, elle est en pull-up et signalerait « pas de débit » en permanence. Activer la sécurité manque de débit vaut également déclaration.","help_i18n":"cfgdocs.poollogic.sensors.flow_present.help"},"poollogic/sensors/ph_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.ph_io_id.label","help_t":"cfgdocs.poollogic.sensors.ph_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO capteur pH","label_i18n":"cfgdocs.poollogic.sensors.ph_io_id.label","help":"Identifiant IO de la mesure pH.","help_i18n":"cfgdocs.poollogic.sensors.ph_io_id.help"},"poollogic/sensors/ph_lvl_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.ph_lvl_io_id.label","help_t":"cfgdocs.poollogic.sensors.ph_lvl_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO niveau cuve pH","label_i18n":"cfgdocs.poollogic.sensors.ph_lvl_io_id.label","help":"Identifiant IO de l'entrée digitale niveau bas cuve pH.","help_i18n":"cfgdocs.poollogic.sensors.ph_lvl_io_id.help"},"poollogic/sensors/pool_lvl_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.pool_lvl_io_id.label","help_t":"cfgdocs.poollogic.sensors.pool_lvl_io_id.help","enum_set":"flowio_logical_input_digital","label":"IO niveau bassin","label_i18n":"cfgdocs.poollogic.sensors.pool_lvl_io_id.label","help":"Identifiant IO de la mesure de niveau bassin.","help_i18n":"cfgdocs.poollogic.sensors.pool_lvl_io_id.help"},"poollogic/sensors/pressure_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.pressure_io_id.label","help_t":"cfgdocs.poollogic.sensors.pressure_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO pression","label_i18n":"cfgdocs.poollogic.sensors.pressure_io_id.label","help":"Identifiant IO du capteur de pression.","help_i18n":"cfgdocs.poollogic.sensors.pressure_io_id.help"},"poollogic/sensors/wat_temp_io_id":{"type":"UInt16","label_t":"cfgdocs.poollogic.sensors.wat_temp_io_id.label","help_t":"cfgdocs.poollogic.sensors.wat_temp_io_id.help","enum_set":"flowio_logical_input_analog","label":"IO température eau","label_i18n":"cfgdocs.poollogic.sensors.wat_temp_io_id.label","help":"Identifiant IO de la sonde température eau.","help_i18n":"cfgdocs.poollogic.sensors.wat_temp_io_id.help"}},"meta":{}}