{"ok":true,"module":"pdm/pd0","docs":{"pdm/pd0/depends_on_mask":{"type":"uint8_t","label_t":"cfgdocs.pdm.pd0.depends_on_mask.label","help_t":"cfgdocs.pdm.pd0.depends_on_mask.help","label":"Masque dépendances","label_i18n":"cfgdocs.pdm.pd0.depends_on_mask.label","help":"Masque de dépendances inter-appareils.","help_i18n":"cfgdocs.pdm.pd0.depends_on_mask.help","visible_if":{"path":"pdm/pd0/enabled","eq":true}},"pdm/pd0/enabled":{"type":"bool","label_t":"cfgdocs.pdm.pd0.enabled.label","help_t":"cfgdocs.pdm.pd0.enabled.help","label":"Appareil installé","label_i18n":"cfgdocs.pdm.pd0.enabled.label","help":"Déclare la pompe de filtration comme présent sur l'installation (slot pd0). Décoché, l'appareil n'est piloté par aucune fonction.","help_i18n":"cfgdocs.pdm.pd0.enabled.help"},"pdm/pd0/max_uptime_day_s":{"type":"int32_t","label_t":"cfgdocs.pdm.pd0.max_uptime_day_s.label","help_t":"cfgdocs.pdm.pd0.max_uptime_day_s.help","unit":"s","label":"Uptime max journalier (s)","label_i18n":"cfgdocs.pdm.pd0.max_uptime_day_s.label","help":"Temps maximal autorisé par jour pour l'appareil.","help_i18n":"cfgdocs.pdm.pd0.max_uptime_day_s.help","visible_if":{"path":"pdm/pd0/enabled","eq":true}},"pdm/pd0/pressure_high_th":{"type":"Float","label_t":"cfgdocs.pdm.pd0.pressure_high_th.label","help_t":"cfgdocs.pdm.pd0.pressure_high_th.help","unit":"bar","label":"Seuil pression haute","label_i18n":"cfgdocs.pdm.pd0.pressure_high_th.label","help":"Seuil de pression haute pour detection d'anomalie.","help_i18n":"cfgdocs.pdm.pd0.pressure_high_th.help","visible_if":{"path":"pdm/pd0/enabled","eq":true}},"pdm/pd0/pressure_low_th":{"type":"Float","label_t":"cfgdocs.pdm.pd0.pressure_low_th.label","help_t":"cfgdocs.pdm.pd0.pressure_low_th.help","unit":"bar","label":"Seuil pression basse","label_i18n":"cfgdocs.pdm.pd0.pressure_low_th.label","help":"Seuil de pression basse pour detection d'anomalie.","help_i18n":"cfgdocs.pdm.pd0.pressure_low_th.help","visible_if":{"path":"pdm/pd0/enabled","eq":true}},"pdm/pd0/pressure_start_dly_s":{"type":"UInt8","label_t":"cfgdocs.pdm.pd0.pressure_start_dly_s.label","help_t":"cfgdocs.pdm.pd0.pressure_start_dly_s.help","unit":"s","label":"Délai démarrage pression (s)","label_i18n":"cfgdocs.pdm.pd0.pressure_start_dly_s.label","help":"Temps d'attente avant vérification pression après démarrage.","help_i18n":"cfgdocs.pdm.pd0.pressure_start_dly_s.help","visible_if":{"path":"pdm/pd0/enabled","eq":true}},"pdm/pd0/pump_flow_m3h":{"type":"Float","label_t":"cfgdocs.pdm.pd0.pump_flow_m3h.label","help_t":"cfgdocs.pdm.pd0.pump_flow_m3h.help","unit":"m3/h","label":"Débit pompe (m³/h)","label_i18n":"cfgdocs.pdm.pd0.pump_flow_m3h.label","help":"Débit réel de la pompe de filtration en m³/h. Le besoin journalier vaut volume du bassin × cycles(température) ÷ débit.","help_i18n":"cfgdocs.pdm.pd0.pump_flow_m3h.help","visible_if":{"path":"pdm/pd0/enabled","eq":true}}},"meta":{}}