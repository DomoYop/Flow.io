{"ok":true,"module":"poollogic/filtration","docs":{"poollogic/filtration/filtr_optimal_min":{"type":"UInt16","unit":"min","label_t":"cfgdocs.poollogic.filtration.filtr_optimal_min.label","help_t":"cfgdocs.poollogic.filtration.filtr_optimal_min.help","label":"Durée optimale calculée","label_i18n":"cfgdocs.poollogic.filtration.filtr_optimal_min.label","help":"Durée optimale de filtration calculée (volume × cycles(T°) ÷ débit), en minutes, avant plafonnement par la capacité des fenêtres. Sortie automatique du plan.","help_i18n":"cfgdocs.poollogic.filtration.filtr_optimal_min.help","hidden":true},"poollogic/filtration/filtr_segments":{"type":"CharArray","label_t":"cfgdocs.poollogic.filtration.filtr_segments.label","help_t":"cfgdocs.poollogic.filtration.filtr_segments.help","label":"Créneaux filtration calculés","label_i18n":"cfgdocs.poollogic.filtration.filtr_segments.label","help":"Liste des créneaux de filtration calculés de la journée, format « HH:MM-HH:MM, … ». Sortie automatique du plan.","help_i18n":"cfgdocs.poollogic.filtration.filtr_segments.help","hidden":true},"poollogic/filtration/filtr_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.filtr_slot.label","help_t":"cfgdocs.poollogic.filtration.filtr_slot.help","enum_set":"poollogic_device_slot","label":"Slot filtration","label_i18n":"cfgdocs.poollogic.filtration.filtr_slot.label","help":"Numéro de slot PDM pilote pour la filtration.","help_i18n":"cfgdocs.poollogic.filtration.filtr_slot.help"},"poollogic/filtration/filtr_start_clc":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.filtr_start_clc.label","help_t":"cfgdocs.poollogic.filtration.filtr_start_clc.help","label":"Début filtration calculé","label_i18n":"cfgdocs.poollogic.filtration.filtr_start_clc.label","help":"Heure de début du segment principal de filtration calculé automatiquement.","help_i18n":"cfgdocs.poollogic.filtration.filtr_start_clc.help","enum_set":"hours_of_day"},"poollogic/filtration/filtr_stop_clc":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.filtr_stop_clc.label","help_t":"cfgdocs.poollogic.filtration.filtr_stop_clc.help","label":"Arrêt filtration calculé","label_i18n":"cfgdocs.poollogic.filtration.filtr_stop_clc.label","help":"Heure de fin du segment principal de filtration calculé automatiquement.","help_i18n":"cfgdocs.poollogic.filtration.filtr_stop_clc.help","enum_set":"hours_of_day"},"poollogic/filtration/filtr_w1_en":{"type":"Bool","label_t":"cfgdocs.poollogic.filtration.filtr_w1_en.label","help_t":"cfgdocs.poollogic.filtration.filtr_w1_en.help","label":"Fenêtre 1 active","label_i18n":"cfgdocs.poollogic.filtration.filtr_w1_en.label","help":"Active la fenêtre de filtration 1.","help_i18n":"cfgdocs.poollogic.filtration.filtr_w1_en.help"},"poollogic/filtration/filtr_w1_prio":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.filtr_w1_prio.label","help_t":"cfgdocs.poollogic.filtration.filtr_w1_prio.help","label":"Fenêtre 1 priorité","label_i18n":"cfgdocs.poollogic.filtration.filtr_w1_prio.label","help":"Priorité de remplissage de la fenêtre 1 (1 = remplie en premier).","help_i18n":"cfgdocs.poollogic.filtration.filtr_w1_prio.help"},"poollogic/filtration/filtr_w1_start":{"type":"UInt16","label_t":"cfgdocs.poollogic.filtration.filtr_w1_start.label","help_t":"cfgdocs.poollogic.filtration.filtr_w1_start.help","unit":"min","label":"Fenêtre 1 début (min)","label_i18n":"cfgdocs.poollogic.filtration.filtr_w1_start.label","help":"Début de la fenêtre 1 en minutes depuis minuit (ex. 480 = 08:00).","help_i18n":"cfgdocs.poollogic.filtration.filtr_w1_start.help"},"poollogic/filtration/filtr_w1_stop":{"type":"UInt16","label_t":"cfgdocs.poollogic.filtration.filtr_w1_stop.label","help_t":"cfgdocs.poollogic.filtration.filtr_w1_stop.help","unit":"min","label":"Fenêtre 1 fin (min)","label_i18n":"cfgdocs.poollogic.filtration.filtr_w1_stop.label","help":"Fin de la fenêtre 1 en minutes depuis minuit. Une fin inférieure au début fait traverser minuit.","help_i18n":"cfgdocs.poollogic.filtration.filtr_w1_stop.help"},"poollogic/filtration/filtr_w2_en":{"type":"Bool","label_t":"cfgdocs.poollogic.filtration.filtr_w2_en.label","help_t":"cfgdocs.poollogic.filtration.filtr_w2_en.help","label":"Fenêtre 2 active","label_i18n":"cfgdocs.poollogic.filtration.filtr_w2_en.label","help":"Active la fenêtre de filtration 2 (gabarit heures creuses 23:30-07:30, priorité à ajuster).","help_i18n":"cfgdocs.poollogic.filtration.filtr_w2_en.help"},"poollogic/filtration/filtr_w2_prio":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.filtr_w2_prio.label","help_t":"cfgdocs.poollogic.filtration.filtr_w2_prio.help","label":"Fenêtre 2 priorité","label_i18n":"cfgdocs.poollogic.filtration.filtr_w2_prio.label","help":"Priorité de remplissage de la fenêtre 2 (1 = remplie en premier, utile pour les heures creuses).","help_i18n":"cfgdocs.poollogic.filtration.filtr_w2_prio.help","visible_if":{"path":"poollogic/filtration/filtr_w2_en","eq":true}},"poollogic/filtration/filtr_w2_start":{"type":"UInt16","label_t":"cfgdocs.poollogic.filtration.filtr_w2_start.label","help_t":"cfgdocs.poollogic.filtration.filtr_w2_start.help","unit":"min","label":"Fenêtre 2 début (min)","label_i18n":"cfgdocs.poollogic.filtration.filtr_w2_start.label","help":"Début de la fenêtre 2 en minutes depuis minuit (ex. 1410 = 23:30).","help_i18n":"cfgdocs.poollogic.filtration.filtr_w2_start.help","visible_if":{"path":"poollogic/filtration/filtr_w2_en","eq":true}},"poollogic/filtration/filtr_w2_stop":{"type":"UInt16","label_t":"cfgdocs.poollogic.filtration.filtr_w2_stop.label","help_t":"cfgdocs.poollogic.filtration.filtr_w2_stop.help","unit":"min","label":"Fenêtre 2 fin (min)","label_i18n":"cfgdocs.poollogic.filtration.filtr_w2_stop.label","help":"Fin de la fenêtre 2 en minutes depuis minuit. Une fin inférieure au début fait traverser minuit.","help_i18n":"cfgdocs.poollogic.filtration.filtr_w2_stop.help","visible_if":{"path":"poollogic/filtration/filtr_w2_en","eq":true}},"poollogic/filtration/filtr_w3_en":{"type":