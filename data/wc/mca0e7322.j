{"ok":true,"module":"poollogic/filtration","docs":{"poollogic/filtration/fenetres":{"label_t":"cfgdocs.poollogic.filtration.fenetres.label","help_t":"cfgdocs.poollogic.filtration.fenetres.help","label":"Fenêtres","label_i18n":"cfgdocs.poollogic.filtration.fenetres.label","help":"Plages horaires autorisées pour la filtration : le besoin journalier calculé y est réparti par ordre de priorité.","help_i18n":"cfgdocs.poollogic.filtration.fenetres.help"},"poollogic/filtration/filtr_cycle_ratio":{"type":"UInt8","unit":"%","label_t":"cfgdocs.poollogic.filtration.filtr_cycle_ratio.label","help_t":"cfgdocs.poollogic.filtration.filtr_cycle_ratio.help","label":"Ratio de cycles","label_i18n":"cfgdocs.poollogic.filtration.filtr_cycle_ratio.label","help":"Ajuste le nombre de renouvellements d'eau visés par jour, en pourcentage de la courbe de référence liée à la température (100 % = courbe d'origine, ex. 1 renouvellement/jour à 22 °C). Augmenter allonge proportionnellement le temps de filtration préconisé ; le résultat reste plafonné par la capacité des fenêtres actives. Plage 50 à 200 %.","help_i18n":"cfgdocs.poollogic.filtration.filtr_cycle_ratio.help"},"poollogic/filtration/filtr_optimal_min":{"type":"UInt16","unit":"min","label_t":"cfgdocs.poollogic.filtration.filtr_optimal_min.label","help_t":"cfgdocs.poollogic.filtration.filtr_optimal_min.help","label":"Durée optimale calculée","label_i18n":"cfgdocs.poollogic.filtration.filtr_optimal_min.label","help":"Durée optimale de filtration calculée (volume × cycles(T°) ÷ débit), en minutes, avant plafonnement par la capacité des fenêtres. Sortie automatique du plan.","help_i18n":"cfgdocs.poollogic.filtration.filtr_optimal_min.help","hidden":true},"poollogic/filtration/filtr_segments":{"type":"CharArray","label_t":"cfgdocs.poollogic.filtration.filtr_segments.label","help_t":"cfgdocs.poollogic.filtration.filtr_segments.help","label":"Créneaux filtration calculés","label_i18n":"cfgdocs.poollogic.filtration.filtr_segments.label","help":"Liste des créneaux de filtration calculés de la journée, format « HH:MM-HH:MM, … ». Sortie automatique du plan.","help_i18n":"cfgdocs.poollogic.filtration.filtr_segments.help","hidden":true},"poollogic/filtration/filtr_start_clc":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.filtr_start_clc.label","help_t":"cfgdocs.poollogic.filtration.filtr_start_clc.help","label":"Début filtration calculé","label_i18n":"cfgdocs.poollogic.filtration.filtr_start_clc.label","help":"Heure de début du segment principal de filtration calculé automatiquement.","help_i18n":"cfgdocs.poollogic.filtration.filtr_start_clc.help","enum_set":"hours_of_day"},"poollogic/filtration/filtr_stop_clc":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.filtr_stop_clc.label","help_t":"cfgdocs.poollogic.filtration.filtr_stop_clc.help","label":"Arrêt filtration calculé","label_i18n":"cfgdocs.poollogic.filtration.filtr_stop_clc.label","help":"Heure de fin du segment principal de filtration calculé automatiquement.","help_i18n":"cfgdocs.poollogic.filtration.filtr_stop_clc.help","enum_set":"hours_of_day"}},"meta":{}}