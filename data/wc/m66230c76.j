{"ok":true,"module":"pdm/pd7","docs":{"pdm/pd7/depends_on_mask":{"type":"uint8_t","label_t":"cfgdocs.pdm.pd7.depends_on_mask.label","help_t":"cfgdocs.pdm.pd7.depends_on_mask.help","label":"Masque dépendances","label_i18n":"cfgdocs.pdm.pd7.depends_on_mask.label","help":"Masque de dépendances inter-appareils.","help_i18n":"cfgdocs.pdm.pd7.depends_on_mask.help","visible_if":{"path":"pdm/pd7/enabled","eq":true}},"pdm/pd7/enabled":{"type":"bool","label_t":"cfgdocs.pdm.pd7.enabled.label","help_t":"cfgdocs.pdm.pd7.enabled.help","label":"Appareil installé","label_i18n":"cfgdocs.pdm.pd7.enabled.label","help":"Déclare le chauffage de l'eau comme présent sur l'installation (slot pd7). Décoché, l'appareil n'est piloté par aucune fonction.","help_i18n":"cfgdocs.pdm.pd7.enabled.help"},"pdm/pd7/max_uptime_day_s":{"type":"int32_t","label_t":"cfgdocs.pdm.pd7.max_uptime_day_s.label","help_t":"cfgdocs.pdm.pd7.max_uptime_day_s.help","unit":"s","label":"Uptime max journalier (s)","label_i18n":"cfgdocs.pdm.pd7.max_uptime_day_s.label","help":"Temps maximal autorisé par jour pour l'appareil.","help_i18n":"cfgdocs.pdm.pd7.max_uptime_day_s.help","visible_if":{"path":"pdm/pd7/enabled","eq":true}},"pdm/pd7/on_delay_s":{"type":"Int32","unit":"s","label_t":"cfgdocs.pdm.pd7.on_delay_s.label","help_t":"cfgdocs.pdm.pd7.on_delay_s.help","label":"Delai d’activation (s)","label_i18n":"cfgdocs.pdm.pd7.on_delay_s.label","help":"Temps d’attente entre la demande de marche et la mise sous tension effective. 0 = demarrage immediat.","help_i18n":"cfgdocs.pdm.pd7.on_delay_s.help","visible_if":{"path":"pdm/pd7/enabled","eq":true}}},"meta":{}}