{"ok":true,"module":"poollogic/safety","docs":{"poollogic/safety/flow_copy_delay_s":{"type":"UInt8","unit":"s","label_t":"cfgdocs.poollogic.safety.flow_copy_delay_s.label","help_t":"cfgdocs.poollogic.safety.flow_copy_delay_s.help","label":"Temporisation de recopie","label_i18n":"cfgdocs.poollogic.safety.flow_copy_delay_s.label","help":"Délai entre la détection du débit et l'activation de la sortie de recopie. La retombée est immédiate.","help_i18n":"cfgdocs.poollogic.safety.flow_copy_delay_s.help"},"poollogic/safety/flow_interlock":{"type":"Bool","label_t":"cfgdocs.poollogic.safety.flow_interlock.label","help_t":"cfgdocs.poollogic.safety.flow_interlock.help","label":"Sécurité manque de débit","label_i18n":"cfgdocs.poollogic.safety.flow_interlock.label","help":"Bloque le dosage et l'électrolyse tant qu'aucun débit n'est détecté.","help_i18n":"cfgdocs.poollogic.safety.flow_interlock.help"},"poollogic/safety/freeze_hold_t":{"type":"Float","label_t":"cfgdocs.poollogic.safety.freeze_hold_t.label","help_t":"cfgdocs.poollogic.safety.freeze_hold_t.help","unit":"C","label":"Seuil maintien hors gel (C)","label_i18n":"cfgdocs.poollogic.safety.freeze_hold_t.label","help":"Temperature de maintien pour la protection hors gel.","help_i18n":"cfgdocs.poollogic.safety.freeze_hold_t.help"},"poollogic/safety/winter_start_t":{"type":"Float","label_t":"cfgdocs.poollogic.safety.winter_start_t.label","help_t":"cfgdocs.poollogic.safety.winter_start_t.help","unit":"C","label":"Seuil entrée hiver (C)","label_i18n":"cfgdocs.poollogic.safety.winter_start_t.label","help":"Temperature de bascule vers la logique hiver.","help_i18n":"cfgdocs.poollogic.safety.winter_start_t.help"}},"meta":{}}