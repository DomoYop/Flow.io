{"ok":true,"module":"poollogic/bassin","docs":{"poollogic/bassin/auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.bassin.auto_mode.label","help_t":"cfgdocs.poollogic.bassin.auto_mode.help","label":"Mode auto global","label_i18n":"cfgdocs.poollogic.bassin.auto_mode.label","help":"Active le pilotage automatique global de la piscine.","help_i18n":"cfgdocs.poollogic.bassin.auto_mode.help"},"poollogic/bassin/disinfection_type":{"type":"UInt8","label_t":"cfgdocs.poollogic.bassin.disinfection_type.label","help_t":"cfgdocs.poollogic.bassin.disinfection_type.help","enum_set":"poollogic_disinfection_type","label":"Type de désinfection","label_i18n":"cfgdocs.poollogic.bassin.disinfection_type.label","help":"Choisit la stratégie de désinfection principale. Le changement est pris en compte au prochain démarrage : c'est lui qui décide des équipements créés, des réglages disponibles et des entités publiées. Une sauvegarde de configuration ne contient que les réglages du mode en cours.","help_i18n":"cfgdocs.poollogic.bassin.disinfection_type.help"},"poollogic/bassin/dly_pid_min":{"type":"UInt8","label_t":"cfgdocs.poollogic.bassin.dly_pid_min.label","help_t":"cfgdocs.poollogic.bassin.dly_pid_min.help","unit":"min","label":"Délai PID après filtration (min)","label_i18n":"cfgdocs.poollogic.bassin.dly_pid_min.label","help":"Délai avant activation des PID après début filtration.","help_i18n":"cfgdocs.poollogic.bassin.dly_pid_min.help"},"poollogic/bassin/enabled":{"type":"Bool","label_t":"cfgdocs.poollogic.bassin.enabled.label","help_t":"cfgdocs.poollogic.bassin.enabled.help","label":"PoolLogic actif","label_i18n":"cfgdocs.poollogic.bassin.enabled.label","help":"Active ou désactive les automatismes PoolLogic.","help_i18n":"cfgdocs.poollogic.bassin.enabled.help"},"poollogic/bassin/pool_volume_m3":{"type":"Float","label_t":"cfgdocs.poollogic.bassin.pool_volume_m3.label","help_t":"cfgdocs.poollogic.bassin.pool_volume_m3.help","unit":"m3","label":"Volume bassin","label_i18n":"cfgdocs.poollogic.bassin.pool_volume_m3.label","help":"Volume du bassin, utilisé pour le besoin de filtration (renouvellement volumique) et pour les doses d'oxygène actif.","help_i18n":"cfgdocs.poollogic.bassin.pool_volume_m3.help"},"poollogic/bassin/winter_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.bassin.winter_mode.label","help_t":"cfgdocs.poollogic.bassin.winter_mode.help","label":"Mode hiver force","label_i18n":"cfgdocs.poollogic.bassin.winter_mode.label","help":"Force le fonctionnement en mode hiver (anti-gel).","help_i18n":"cfgdocs.poollogic.bassin.winter_mode.help"}},"meta":{}}