{"ok":true,"module":"poollogic/chlorine","docs":{"poollogic/chlorine/dis_auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.chlorine.dis_auto_mode.label","help_t":"cfgdocs.poollogic.chlorine.dis_auto_mode.help","label":"Mode auto ORP","label_i18n":"cfgdocs.poollogic.chlorine.dis_auto_mode.label","help":"Active la régulation automatique ORP/chlore.","help_i18n":"cfgdocs.poollogic.chlorine.dis_auto_mode.help","visible_if":[{"path":"poollogic/modes/disinfection_type","eq":1},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/chlorine/dis_kd":{"type":"Float","label_t":"cfgdocs.poollogic.chlorine.dis_kd.label","help_t":"cfgdocs.poollogic.chlorine.dis_kd.help","label":"ORP Kd","label_i18n":"cfgdocs.poollogic.chlorine.dis_kd.label","help":"Gain dérivé du régulateur ORP.","help_i18n":"cfgdocs.poollogic.chlorine.dis_kd.help","visible_if":[{"path":"poollogic/modes/disinfection_type","eq":1},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/chlorine/dis_ki":{"type":"Float","label_t":"cfgdocs.poollogic.chlorine.dis_ki.label","help_t":"cfgdocs.poollogic.chlorine.dis_ki.help","label":"ORP Ki","label_i18n":"cfgdocs.poollogic.chlorine.dis_ki.label","help":"Gain intégral du régulateur ORP.","help_i18n":"cfgdocs.poollogic.chlorine.dis_ki.help","visible_if":[{"path":"poollogic/modes/disinfection_type","eq":1},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/chlorine/dis_kp":{"type":"Float","label_t":"cfgdocs.poollogic.chlorine.dis_kp.label","help_t":"cfgdocs.poollogic.chlorine.dis_kp.help","label":"ORP Kp","label_i18n":"cfgdocs.poollogic.chlorine.dis_kp.label","help":"Gain proportionnel du régulateur ORP.","help_i18n":"cfgdocs.poollogic.chlorine.dis_kp.help","visible_if":[{"path":"poollogic/modes/disinfection_type","eq":1},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/chlorine/dis_pump_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.chlorine.dis_pump_slot.label","help_t":"cfgdocs.poollogic.chlorine.dis_pump_slot.help","enum_set":"poollogic_device_slot","label":"Slot pompe chlore liquide","label_i18n":"cfgdocs.poollogic.chlorine.dis_pump_slot.label","help":"Numéro de slot PDM associé à la pompe ORP/chlore liquide.","help_i18n":"cfgdocs.poollogic.chlorine.dis_pump_slot.help","visible_if":[{"path":"poollogic/modes/disinfection_type","in":[1,3]},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/chlorine/dis_setpoint":{"type":"Float","label_t":"cfgdocs.poollogic.chlorine.dis_setpoint.label","help_t":"cfgdocs.poollogic.chlorine.dis_setpoint.help","label":"Consigne ORP","label_i18n":"cfgdocs.poollogic.chlorine.dis_setpoint.label","help":"Valeur cible ORP (redox) mesurant le niveau de désinfectant dans l'eau, commune à tous les modes de désinfection.","help_i18n":"cfgdocs.poollogic.chlorine.dis_setpoint.help"},"poollogic/chlorine/dis_window_ms":{"type":"Int32","label_t":"cfgdocs.poollogic.chlorine.dis_window_ms.label","help_t":"cfgdocs.poollogic.chlorine.dis_window_ms.help","unit":"ms","label":"Fenêtre ORP (ms)","label_i18n":"cfgdocs.poollogic.chlorine.dis_window_ms.label","help":"Fenêtre temporelle PWM appliquée a la pompe ORP.","help_i18n":"cfgdocs.poollogic.chlorine.dis_window_ms.help","visible_if":[{"path":"poollogic/modes/disinfection_type","eq":1},{"path":"pdm/pd2/enabled","eq":true}]}},"meta":{}}