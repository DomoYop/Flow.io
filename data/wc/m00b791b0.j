{"ok":true,"module":"poollogic/ph","docs":{"poollogic/ph/ph_auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.ph.ph_auto_mode.label","help_t":"cfgdocs.poollogic.ph.ph_auto_mode.help","label":"Mode auto pH","label_i18n":"cfgdocs.poollogic.ph.ph_auto_mode.label","help":"Active la régulation automatique du pH.","help_i18n":"cfgdocs.poollogic.ph.ph_auto_mode.help","visible_if":{"path":"pdm/pd1/enabled","eq":true}},"poollogic/ph/ph_dose_plus":{"type":"Bool","label_t":"cfgdocs.poollogic.ph.ph_dose_plus.label","help_t":"cfgdocs.poollogic.ph.ph_dose_plus.help","label":"Injection pH+","label_i18n":"cfgdocs.poollogic.ph.ph_dose_plus.label","help":"Si activé, la pompe pH injecte du pH+ (sinon pH-).","help_i18n":"cfgdocs.poollogic.ph.ph_dose_plus.help","visible_if":{"path":"pdm/pd1/enabled","eq":true}},"poollogic/ph/ph_kd":{"type":"Float","label_t":"cfgdocs.poollogic.ph.ph_kd.label","help_t":"cfgdocs.poollogic.ph.ph_kd.help","label":"pH Kd","label_i18n":"cfgdocs.poollogic.ph.ph_kd.label","help":"Gain dérivé du régulateur pH.","help_i18n":"cfgdocs.poollogic.ph.ph_kd.help","visible_if":{"path":"pdm/pd1/enabled","eq":true}},"poollogic/ph/ph_ki":{"type":"Float","label_t":"cfgdocs.poollogic.ph.ph_ki.label","help_t":"cfgdocs.poollogic.ph.ph_ki.help","label":"pH Ki","label_i18n":"cfgdocs.poollogic.ph.ph_ki.label","help":"Gain intégral du régulateur pH.","help_i18n":"cfgdocs.poollogic.ph.ph_ki.help","visible_if":{"path":"pdm/pd1/enabled","eq":true}},"poollogic/ph/ph_kp":{"type":"Float","label_t":"cfgdocs.poollogic.ph.ph_kp.label","help_t":"cfgdocs.poollogic.ph.ph_kp.help","label":"pH Kp","label_i18n":"cfgdocs.poollogic.ph.ph_kp.label","help":"Gain proportionnel du régulateur pH.","help_i18n":"cfgdocs.poollogic.ph.ph_kp.help","visible_if":{"path":"pdm/pd1/enabled","eq":true}},"poollogic/ph/ph_pump_slot":{"type":"UInt8","label_t":"cfgdocs.poollogic.ph.ph_pump_slot.label","help_t":"cfgdocs.poollogic.ph.ph_pump_slot.help","enum_set":"poollogic_device_slot","label":"Slot pompe pH","lab