day.help","hidden":true},"poollogic/disinfection/load_factor":{"type":"Float","label_t":"cfgdocs.poollogic.disinfection.load_factor.label","help_t":"cfgdocs.poollogic.disinfection.load_factor.help","label":"Facteur charge O2","label_i18n":"cfgdocs.poollogic.disinfection.load_factor.label","help":"Facteur manuel appliqué au dosage O2 calculé.","help_i18n":"cfgdocs.poollogic.disinfection.load_factor.help","visible_if":[{"path":"poollogic/bassin/disinfection_type","eq":3},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/disinfection/main_hour":{"type":"UInt8","label_t":"cfgdocs.poollogic.disinfection.main_hour.label","help_t":"cfgdocs.poollogic.disinfection.main_hour.help","enum_set":"hours_of_day","label":"Heure dosage O2","label_i18n":"cfgdocs.poollogic.disinfection.main_hour.label","help":"Heure principale prévue pour le dosage O2.","help_i18n":"cfgdocs.poollogic.disinfection.main_hour.help","visible_if":[{"path":"poollogic/bassin/disinfection_type","eq":3},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/disinfection/min_filter_run_min":{"type":"UInt8","label_t":"cfgdocs.poollogic.disinfection.min_filter_run_min.label","help_t":"cfgdocs.poollogic.disinfection.min_filter_run_min.help","unit":"min","label":"Filtration mini O2","label_i18n":"cfgdocs.poollogic.disinfection.min_filter_run_min.label","help":"Durée minimale de filtration avant autorisation du dosage O2.","help_i18n":"cfgdocs.poollogic.disinfection.min_filter_run_min.help","visible_if":[{"path":"poollogic/bassin/disinfection_type","eq":3},{"path":"pdm/pd2/enabled","eq":true}]},"poollogic/disinfection/pending_ml":{"type":"Float","label_t":"cfgdocs.poollogic.disinfection.pending_ml.label","help_t":"cfgdocs.poollogic.disinfection.pending_ml.help","unit":"ml","label":"O2 en attente","label_i18n":"cfgdocs.poollogic.disinfection.pending_ml.label","help":"Volume O2 restant à injecter après interruption ou reboot.","help_i18n":"cfgdocs.poollogic.disinfection.pending_ml.help","hidden":true},"poollogic/disinfectio