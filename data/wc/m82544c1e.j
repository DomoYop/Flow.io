p":"Électrolyseur au sel. Production pilotée en pourcentage ou sur consigne ORP.","help_i18n":"cfgmods.piscine.desinfection-electrolyseur.help"},"piscine/desinfection-o2":{"label_t":"cfgmods.piscine.desinfection-o2.label","help_t":"cfgmods.piscine.desinfection-o2.help","order":140,"compose":[{"module":"pdm/pd4","fields":["enabled"],"label_t":"cfgmods.piscine.section.activation"},{"module":"io/output/d04","fields":["binding_port"],"label_t":"cfgmods.piscine.section.sortie"},{"module":"pdm/pd4","fields":["flow_l_h","tank_cap_ml","tank_init_ml","max_uptime_day_s","depends_on_mask"],"label_t":"cfgmods.piscine.section.equipement"},{"module":"poollogic/disinfection","fields":["dose_ml_10m3_week","main_hour","split_count","temp_comp","load_factor","min_filter_run_min"],"label_t":"cfgmods.piscine.section.regulation"}],"label":"Désinfection — oxygène actif","label_i18n":"cfgmods.piscine.desinfection-o2.label","help":"Oxygène actif dosé par protocole hebdomadaire, réparti sur plusieurs injections.","help_i18n":"cfgmods.piscine.desinfection-o2.help"},"piscine/eclairage":{"label_t":"cfgmods.piscine.eclairage.label","help_t":"cfgmods.piscine.eclairage.help","order":160,"compose":[{"module":"pdm/pd6","fields":["enabled"],"label_t":"cfgmods.piscine.section.activation"},{"module":"io/output/d06","fields":["binding_port"],"label_t":"cfgmods.piscine.section.sortie"},{"module":"pdm/pd6","fields":["on_delay_s","max_uptime_day_s","depends_on_mask"],"label_t":"cfgmods.piscine.section.equipement"}],"label":"Éclairage","label_i18n":"cfgmods.piscine.eclairage.label","help":"Éclairage du bassin, piloté manuellement ou par planification.","help_i18n":"cfgmods.piscine.eclairage.help"},"piscine/filtration":{"label_t":"cfgmods.piscine.filtration.label","help_t":"cfgmods.piscine.filtration.help","order":100,"compose":[{"module":"pdm/pd0","fields":["enabled"],"label_t":"cfgmods.piscine.section.activation"},{"module":"io/output/d00","fields":["binding_port"],"label_t":"cfgmods.piscine.section.sorti